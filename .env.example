# Supabase Cloud PostgreSQL Connection String (Port 6543 pooler recommended for Vercel/serverless)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Direct connection (Port 5432 for migrations)
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase API & Auth Keys
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=[YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY]
SUPABASE_SECRET_KEY=[YOUR-SUPABASE-SECRET-KEY]
SUPABASE_JWKS_URL=https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json

# Frontend Supabase Public Keys
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY]
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY]

# External Crop Disease AI Microservice (Render deep learning API)
CROP_DISEASE_AI_URL=https://cropdiseaseai-mvcq.onrender.com

# Security & CORS:
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me-agriconnect
JWT_EXPIRY_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
